// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  emailVerified   Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  tasksCreated             Task[]                  @relation("CreatedTasks")
  tasksAssigned            Task[]                  @relation("AssignedTasks")
  subtasksAssigned         Subtask[]               @relation("AssignedSubtasks")
  projectsCreated          Project[]               @relation("CreatedProjects")
  projectMemberships       ProjectMember[]
  taskWatchers             TaskWatcher[]
  comments                 Comment[]
  activities               Activity[]
  teamMemberships          TeamMembership[]
  teamsOwned               Team[]                  @relation("OwnedTeams")
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  notifications            Notification[]          @relation("UserNotifications")
  actorNotifications       Notification[]          @relation("ActorNotifications")
  notificationPreferences  NotificationPreference?

  @@map("users")
}

// ─── Multi-tenancy ───────────────────────────────────────────────────────────

model Team {
  id        String   @id @default(uuid())
  name      String
  ownerId   String
  createdAt DateTime @default(now())

  owner         User             @relation("OwnedTeams", fields: [ownerId], references: [id])
  memberships   TeamMembership[]
  projects      Project[]
  tasks         Task[]
  notifications Notification[]

  @@map("teams")
}

model TeamMembership {
  userId    String
  teamId    String
  role      String   @default("member") // owner | admin | member
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("team_memberships")
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  icon        String?   @default("📁")
  color       String?   @default("#6366f1")
  status      String    @default("active") // active | planning | in_progress | completed | on_hold | archived
  startDate   DateTime?
  targetDate  DateTime?
  order       Float     @default(0)
  isArchived  Boolean   @default(false)
  teamId      String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User            @relation("CreatedProjects", fields: [createdById], references: [id])
  tasks     Task[]
  members   ProjectMember[]

  @@index([teamId, status])
  @@index([teamId, isArchived])
  @@index([teamId, order])
  @@index([teamId, createdAt])
  @@map("projects")
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("member") // lead | member | viewer
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("medium") // low | medium | high | urgent
  labels      String[] @default([])
  order       Float    @default(0)
  dueDate     DateTime?
  assigneeId  String?
  createdById String
  teamId      String
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee      User?          @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy     User           @relation("CreatedTasks", fields: [createdById], references: [id])
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments      Comment[]
  activities    Activity[]
  watchers      TaskWatcher[]
  subtasks      Subtask[]
  notifications Notification[]

  @@index([teamId, status, order])
  @@index([teamId, order])
  @@index([teamId, status])
  @@index([teamId, dueDate])
  @@index([teamId, assigneeId])
  @@index([teamId, projectId])
  @@index([projectId])
  @@index([teamId, createdAt])
  @@map("tasks")
}

// ─── Supporting models ────────────────────────────────────────────────────────

model TaskWatcher {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_watchers")
}

model Subtask {
  id         String    @id @default(uuid())
  title      String
  completed  Boolean   @default(false)
  order      Float     @default(0)
  dueDate    DateTime?
  taskId     String
  assigneeId String?
  parentId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User?     @relation("AssignedSubtasks", fields: [assigneeId], references: [id])
  parent   Subtask?  @relation("NestedSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children Subtask[] @relation("NestedSubtasks")

  @@index([taskId, order])
  @@index([taskId, parentId])
  @@index([taskId, completed])
  @@map("subtasks")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model Activity {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
  @@map("activities")
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique   // SHA-256 hash of the raw token sent by email
  userId    String
  expiresAt DateTime
  usedAt    DateTime?          // null = unused; set when the reset succeeds

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Email Verification ───────────────────────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique   // SHA-256 hash of the raw token sent by email
  userId    String
  expiresAt DateTime
  usedAt    DateTime?          // null = unused; set when verification succeeds

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String    // Recipient user ID
  actorId   String?   // User who performed the action
  teamId    String?   // Team scope
  taskId    String?   // Task context (if task-related)
  type      String    // task_assigned | task_reassigned | status_changed | task_completed | mention | comment_created | due_date_approaching | overdue | team_invitation | role_changed
  title     String
  message   String
  data      Json?     // Metadata payload
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([teamId])
  @@map("notifications")
}

model NotificationPreference {
  userId              String   @id
  taskAssigned        Boolean  @default(true)
  statusChanged       Boolean  @default(true)
  commentsAndMentions Boolean  @default(true)
  dueDates            Boolean  @default(true)
  teamUpdates         Boolean  @default(true)
  emailNotifications  Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

