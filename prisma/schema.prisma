// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  passwordHash    String
  name            String
  emailVerified   Boolean   @default(false)
  isDeleted       Boolean   @default(false)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())

  tasksCreated             Task[]                  @relation("CreatedTasks")
  tasksAssigned            Task[]                  @relation("AssignedTasks")
  subtasksAssigned         Subtask[]               @relation("AssignedSubtasks")
  projectsCreated          Project[]               @relation("CreatedProjects")
  projectMemberships       ProjectMember[]
  taskWatchers             TaskWatcher[]
  comments                 Comment[]
  activities               Activity[]
  teamMemberships          TeamMembership[]
  teamsOwned               Team[]                  @relation("OwnedTeams")
  passwordResetTokens      PasswordResetToken[]
  emailVerificationTokens  EmailVerificationToken[]
  notifications            Notification[]          @relation("UserNotifications")
  actorNotifications       Notification[]          @relation("ActorNotifications")
  notificationPreferences  NotificationPreference?
  savedSearches            SavedSearch[]
  recentSearches           RecentSearch[]
  apiKeys                  ApiKey[]
  webhooksCreated          Webhook[]
  githubIntegrationsCreated ProjectGitHubIntegration[]
  chatIntegrationsCreated  TeamChatIntegration[]
  attachmentsUploaded      TaskAttachment[]

  @@map("users")
}

// ─── Multi-tenancy ───────────────────────────────────────────────────────────

model Team {
  id                 String    @id @default(uuid())
  name               String
  ownerId            String
  customGeminiKey    String?   // AES-256-GCM encrypted custom Gemini API key (BYOK)
  aiMonthlyUsage     Int       @default(0)
  aiUsageResetAt     DateTime?
  createdAt          DateTime  @default(now())

  owner              User             @relation("OwnedTeams", fields: [ownerId], references: [id])
  memberships        TeamMembership[]
  projects           Project[]
  tasks              Task[]
  notifications      Notification[]
  savedSearches      SavedSearch[]
  recentSearches     RecentSearch[]
  apiKeys            ApiKey[]
  webhooks           Webhook[]
  githubIntegrations ProjectGitHubIntegration[]
  chatIntegrations   TeamChatIntegration[]
  attachments        TaskAttachment[]

  @@map("teams")
}

model TeamMembership {
  userId    String
  teamId    String
  role      String   @default("member") // owner | admin | member
  joinedAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
  @@map("team_memberships")
}

// ─── Projects ────────────────────────────────────────────────────────────────

model Project {
  id          String    @id @default(uuid())
  name        String
  description String?
  icon        String?   @default("📁")
  color       String?   @default("#6366f1")
  status      String    @default("active") // active | planning | in_progress | completed | on_hold | archived
  startDate   DateTime?
  targetDate  DateTime?
  order       Float     @default(0)
  isArchived  Boolean   @default(false)
  teamId      String
  createdById String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  team      Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy User            @relation("CreatedProjects", fields: [createdById], references: [id])
  tasks     Task[]
  members   ProjectMember[]
  githubIntegration ProjectGitHubIntegration?
  githubResourceLinks GitHubResourceLink[]
  githubEvents        GitHubEvent[]
  chatIntegrations    TeamChatIntegration[]

  @@index([teamId, status])
  @@index([teamId, isArchived])
  @@index([teamId, order])
  @@index([teamId, createdAt])
  @@map("projects")
}

model ProjectMember {
  projectId String
  userId    String
  role      String   @default("member") // lead | member | viewer
  joinedAt  DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([projectId, userId])
  @@map("project_members")
}

// ─── Tasks ───────────────────────────────────────────────────────────────────

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("todo")
  priority    String   @default("medium") // low | medium | high | urgent
  labels      String[] @default([])
  order       Float    @default(0)
  dueDate     DateTime?
  assigneeId  String?
  createdById String
  teamId      String
  projectId   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  assignee      User?          @relation("AssignedTasks", fields: [assigneeId], references: [id])
  createdBy     User           @relation("CreatedTasks", fields: [createdById], references: [id])
  team          Team           @relation(fields: [teamId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  comments      Comment[]
  activities    Activity[]
  watchers      TaskWatcher[]
  subtasks      Subtask[]
  notifications Notification[]
  githubLinks   GitHubResourceLink[]
  attachments   TaskAttachment[]

  @@index([teamId, status, order])
  @@index([teamId, order])
  @@index([teamId, status])
  @@index([teamId, dueDate])
  @@index([teamId, assigneeId])
  @@index([teamId, projectId])
  @@index([projectId])
  @@index([teamId, createdAt])
  @@map("tasks")
}

model TaskAttachment {
  id          String   @id @default(uuid())
  taskId      String
  teamId      String
  uploaderId  String
  fileName    String
  fileSize    Int
  mimeType    String
  storagePath String
  createdAt   DateTime @default(now())

  task     Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  team     Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Cascade)

  @@index([teamId, taskId])
  @@index([taskId])
  @@map("task_attachments")
}

// ─── Supporting models ────────────────────────────────────────────────────────

model TaskWatcher {
  taskId    String
  userId    String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@map("task_watchers")
}

model Subtask {
  id         String    @id @default(uuid())
  title      String
  completed  Boolean   @default(false)
  order      Float     @default(0)
  dueDate    DateTime?
  taskId     String
  assigneeId String?
  parentId   String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  task     Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  assignee User?     @relation("AssignedSubtasks", fields: [assigneeId], references: [id])
  parent   Subtask?  @relation("NestedSubtasks", fields: [parentId], references: [id], onDelete: Cascade)
  children Subtask[] @relation("NestedSubtasks")

  @@index([taskId, order])
  @@index([taskId, parentId])
  @@index([taskId, completed])
  @@map("subtasks")
}

model Comment {
  id        String   @id @default(uuid())
  content   String
  taskId    String
  authorId  String
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id])

  @@map("comments")
}

model Activity {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  action    String
  details   String?
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
  @@map("activities")
}

// ─── Password Reset ───────────────────────────────────────────────────────────

model PasswordResetToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique   // SHA-256 hash of the raw token sent by email
  userId    String
  expiresAt DateTime
  usedAt    DateTime?          // null = unused; set when the reset succeeds

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─── Email Verification ───────────────────────────────────────────────────────

model EmailVerificationToken {
  id        String   @id @default(uuid())
  tokenHash String   @unique   // SHA-256 hash of the raw token sent by email
  userId    String
  expiresAt DateTime
  usedAt    DateTime?          // null = unused; set when verification succeeds

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

// ─── Notifications ────────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(uuid())
  userId    String    // Recipient user ID
  actorId   String?   // User who performed the action
  teamId    String?   // Team scope
  taskId    String?   // Task context (if task-related)
  type      String    // task_assigned | task_reassigned | status_changed | task_completed | mention | comment_created | due_date_approaching | overdue | team_invitation | role_changed
  title     String
  message   String
  data      Json?     // Metadata payload
  read      Boolean   @default(false)
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user  User  @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("ActorNotifications", fields: [actorId], references: [id], onDelete: SetNull)
  team  Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  task  Task? @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([userId, createdAt])
  @@index([teamId])
  @@map("notifications")
}

model NotificationPreference {
  userId              String   @id
  taskAssigned        Boolean  @default(true)
  statusChanged       Boolean  @default(true)
  commentsAndMentions Boolean  @default(true)
  dueDates            Boolean  @default(true)
  teamUpdates         Boolean  @default(true)
  emailNotifications  Boolean  @default(false)
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

// ─── Search ───────────────────────────────────────────────────────────────────

model SavedSearch {
  id        String   @id @default(uuid())
  name      String
  query     String
  filters   Json?
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([userId, teamId])
  @@map("saved_searches")
}

model RecentSearch {
  id        String   @id @default(uuid())
  query     String
  userId    String
  teamId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([userId, teamId, query])
  @@index([userId, teamId, updatedAt])
  @@map("recent_searches")
}

// ─── Developer & Integrations (Phase 31) ──────────────────────────────────────

model ApiKey {
  id          String    @id @default(uuid())
  name        String
  keyPrefix   String    // e.g. "tf_live_12345678" (first 16 chars for display)
  keyHash     String    @unique // SHA-256 hash of the full secret key
  scopes      String[]  @default(["*"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  revokedAt   DateTime?
  userId      String
  teamId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId, revokedAt])
  @@index([keyHash])
  @@map("api_keys")
}

model Webhook {
  id          String            @id @default(uuid())
  name        String
  url         String
  secret      String            // Signing secret e.g. "whsec_..."
  events      String[]          // ["task.created", "task.updated", ...]
  isActive    Boolean           @default(true)
  teamId      String
  createdById String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy  User              @relation(fields: [createdById], references: [id], onDelete: Cascade)
  deliveries WebhookDelivery[]

  @@index([teamId, isActive])
  @@map("webhooks")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  event        String
  payload      Json
  statusCode   Int?
  responseBody String?
  durationMs   Int?
  status       String    @default("pending") // pending | success | failed
  attempts     Int       @default(1)
  error        String?
  deliveredAt  DateTime?
  createdAt    DateTime  @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId, createdAt])
  @@map("webhook_deliveries")
}

// ─── GitHub Integration (Phase 32) ──────────────────────────────────────────

model ProjectGitHubIntegration {
  id                     String   @id @default(uuid())
  projectId              String   @unique
  teamId                 String
  repoOwner              String
  repoName               String
  repoFullName           String   // e.g. "brixcel/taskflow"
  webhookSecret          String   // e.g. "gh_whsec_..."
  autoCloseTasks         Boolean  @default(true)
  autoCreateTasksOnIssue Boolean  @default(false)
  defaultIssueStatus     String   @default("todo")
  syncBranches           String[] @default(["main", "master"])
  isActive               Boolean  @default(true)
  lastSyncedAt           DateTime?
  createdById            String
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  project     Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  team        Team                 @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User                 @relation(fields: [createdById], references: [id], onDelete: Cascade)
  links       GitHubResourceLink[]
  events      GitHubEvent[]

  @@index([teamId, isActive])
  @@index([repoFullName])
  @@map("project_github_integrations")
}

model GitHubResourceLink {
  id             String    @id @default(uuid())
  integrationId  String
  projectId      String
  taskId         String?
  resourceType   String    // pull_request | issue | commit | branch
  resourceNumber Int?      // e.g. 42
  resourceRef    String    // e.g. "PR #42", "Issue #10", "Commit 7f3a9b"
  title          String
  url            String
  author         String?
  status         String?   // open | closed | merged
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  integration ProjectGitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([projectId, resourceType])
  @@index([taskId])
  @@index([integrationId])
  @@map("github_resource_links")
}

model GitHubEvent {
  id            String   @id @default(uuid())
  integrationId String
  projectId     String
  eventType     String   // pull_request | issues | push | ping
  action        String?  // opened | closed | merged | synchronize
  sender        String?
  payload       Json
  processed     Boolean  @default(true)
  error         String?
  createdAt     DateTime @default(now())

  integration ProjectGitHubIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  project     Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, eventType])
  @@index([integrationId, createdAt])
  @@map("github_events")
}

// ─── Slack / Discord Integrations (Phase 33) ──────────────────────────────────

model TeamChatIntegration {
  id                    String    @id @default(uuid())
  teamId                String
  provider              String    // slack | discord
  name                  String
  webhookUrl            String
  channelName           String?
  events                String[]  @default(["task_assigned", "task_completed", "task_overdue", "project_updated", "comment_created"])
  filterProjectId       String?
  includePrivateDetails Boolean   @default(false)
  isActive              Boolean   @default(true)
  lastTriggeredAt       DateTime?
  lastStatus            String?   // success | failed
  lastError             String?
  createdById           String
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  team        Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  project     Project?  @relation(fields: [filterProjectId], references: [id], onDelete: SetNull)
  deliveries  ChatIntegrationDelivery[]

  @@index([teamId, isActive])
  @@index([provider])
  @@map("team_chat_integrations")
}

model ChatIntegrationDelivery {
  id            String    @id @default(uuid())
  integrationId String
  event         String
  payload       Json
  statusCode    Int?
  responseBody  String?
  durationMs    Int?
  status        String    @default("pending") // success | failed
  error         String?
  deliveredAt   DateTime?
  createdAt     DateTime  @default(now())

  integration TeamChatIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)

  @@index([integrationId, createdAt])
  @@map("chat_integration_deliveries")
}


