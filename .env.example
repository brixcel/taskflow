# Copy this file to .env and fill in real values before starting the server.
# The server refuses to start if any required variable (non-optional ones) is missing.

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/taskflow

# ── Auth & Session Security ───────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
# Session lifetime in days (default: 7). Can use SESSION_MAX_AGE_SECONDS for test/dev overrides.
SESSION_MAX_AGE_DAYS=7
# SESSION_MAX_AGE_SECONDS=60
# Maximum concurrent active sessions per user before LRU eviction (default: 5)
MAX_CONCURRENT_SESSIONS=5

# ── Email Service (Resend API or SMTP) ──────────────────────────────────────────
# Set RESEND_API_KEY to send emails via Resend API (https://resend.com)
# RESEND_API_KEY=re_your_api_key_here

# Standard SMTP configuration (optional fallback):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
EMAIL_FROM="TaskFlow <onboarding@resend.dev>"

# ── URLs ──────────────────────────────────────────────────────────────────────
APP_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Sentry (optional — Phase 9) ───────────────────────────────────────────────
# Omit or leave blank to disable error tracking. Server starts normally either way.
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-project-id

# ── Cloudflare Turnstile CAPTCHA (optional — Charter C12, C13) ────────────────
# Omit or leave blank in local dev to bypass CAPTCHA.
# Production setup: https://dash.cloudflare.com → Turnstile → Add Site
# TURNSTILE_SECRET_KEY=0x4AAAAAA...
# VITE_TURNSTILE_SITE_KEY=0x4AAAAAA...

