# ==============================================================================
# TaskFlow — Production Environment Variables (.env.production)
# ==============================================================================
# In production, set these variables in your hosting provider's dashboard
# (Render, Railway, Fly.io, AWS, Heroku) or your secure container orchestrator.
# DO NOT commit actual secrets or production credentials to source control.
# ==============================================================================

NODE_ENV=production
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
# Connection string to your managed production PostgreSQL database (Supabase, Neon, AWS RDS)
# MUST NOT share database instances with development or staging environments.
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?sslmode=require
DATABASE_URL="postgresql://postgres:YOUR_PROD_DB_PASSWORD@your-prod-db-host.pooler.supabase.com:5432/postgres?sslmode=require"

# ─── Security & Authentication ────────────────────────────────────────────────
# High-entropy secret key for signing production JWT tokens.
# Generate via: openssl rand -hex 32
JWT_SECRET="generate-a-cryptographically-secure-64-character-hex-string"

# ─── CORS & Domain Scoping ────────────────────────────────────────────────────
# Must match the exact URL of your production frontend application (no trailing slash).
# Prevents unauthorized origins from accessing your API.
APP_URL="https://taskflow-app.vercel.app"
CORS_ORIGIN="https://taskflow-app.vercel.app"

# ─── Email Delivery (Resend API or SMTP) ───────────────────────────────────────
# Option A: Resend API (Recommended for production transactional email)
# Obtain your production API key at https://resend.com
RESEND_API_KEY="re_prod_your_resend_api_key"
EMAIL_FROM="TaskFlow <noreply@yourdomain.com>"

# Option B: Standard SMTP fallback
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your-smtp-password

# ─── Observability & Monitoring (Phase 9) ─────────────────────────────────────
# Sentry DSN for production exception tracking and performance tracing.
# Leave empty to disable error telemetry.
SENTRY_DSN="https://prod-key@o0.ingest.sentry.io/your-project-id"
