# Copy this file to .env.local and fill in real values.
# Vite only exposes variables prefixed with VITE_ to the browser bundle.

# ── API ───────────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000

# ── Sentry (optional — Phase 9) ───────────────────────────────────────────────
# Omit or leave blank to disable frontend error tracking.
# Get your DSN from: https://sentry.io → Project Settings → Client Keys (DSN)
# IMPORTANT: use a *browser* project DSN here, not the backend DSN.
# VITE_SENTRY_DSN=https://your-key@o0.ingest.sentry.io/your-browser-project-id
